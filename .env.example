# Copy to .env.local and fill in values. Do not commit .env.local.

# Supabase (required) — use GUILD_* (or legacy NC_UNITED_*)
NEXT_PUBLIC_GUILD_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_GUILD_SUPABASE_ANON_KEY=eyJ...
GUILD_SUPABASE_SERVICE_KEY=eyJ...
# Legacy (still supported): NEXT_PUBLIC_NC_UNITED_SUPABASE_URL, NEXT_PUBLIC_NC_UNITED_SUPABASE_ANON_KEY, NC_UNITED_SUPABASE_SERVICE_KEY
#
# Hosted Supabase Auth caps signup / password-reset / magic-link emails per hour (per project).
# For heavy QA: use a second "dev" Supabase project in .env.local, or `supabase start` locally
# (emails in Inbucket) so you do not burn production’s quota.
#
# Password reset emails must be requested from the browser (Forgot password page) so PKCE
# code_verifier is stored in the user’s browser. Do not send recovery via a server-only route.

# Stripe (required when STRIPE_CHECKOUT_ENABLED=true) — use GUILD_* (or legacy NC_UNITED_*)
NEXT_PUBLIC_GUILD_STRIPE_KEY=pk_test_...
GUILD_STRIPE_SECRET_KEY=sk_test_...
GUILD_STRIPE_WEBHOOK_SECRET=whsec_...
# Legacy: NEXT_PUBLIC_NC_UNITED_STRIPE_KEY, NC_UNITED_STRIPE_SECRET_KEY, NC_UNITED_STRIPE_WEBHOOK_SECRET

# Set to "true" to enable Stripe Checkout on booking. Omit or "false" = no payment (sessions stay pending_payment).
STRIPE_CHECKOUT_ENABLED=true

# Local dev only: when NODE_ENV=development and this is "true", booking charges $0.50 on Stripe
# (ignored on preview/production even if left "true"). Omit or "false" for normal pricing.
TEST_MODE_PENNY_PRICING=false

# Resend (transactional email: coach application confirmations, admin alerts, approve/reject)
# https://resend.com — add API key and verify a sending domain (or use onboarding@resend.dev for testing only).
# RESEND_API_KEY=re_...
# Optional: from address (must be allowed for your Resend domain). Default: The Guild <onboarding@resend.dev>
# EMAIL_FROM=The Guild <onboarding@yourdomain.com>
# Optional: where new coach-application alerts go. Default: tenant support email (e.g. info@WrestlingGuild.com from config).
# COACH_APPLICATIONS_NOTIFY_EMAIL=ops@example.com

# Mapbox (public token for Coach Locator map — NC coach pins on homepage & /coaches/map)
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ...

# Optional: public app URL (include https), e.g. https://www.wrestlingguild.com
# Strongly recommended in production for: password-reset email links, Stripe redirects,
# post-Stripe register/confirmed + registration-status when the hostname isn’t in config/tenants.ts.
# Without this, reset emails may use the wrong host if Site URL / env is misconfigured.
# NEXT_PUBLIC_APP_URL=https://www.wrestlingguild.com

# Optional: secret for post-payment confirmation tokens (so returning from Stripe shows confirmation even if auth cookie is lost). Min 16 chars.
# CONFIRMATION_TOKEN_SECRET=your-secret-at-least-16-chars

# Optional: comma-separated emails that get admin role on login
# ADMIN_EMAILS=admin@example.com,other@example.com

# Checkout pricing: by default the app does NOT apply saved account discounts at payment.
# Parents must enter a promo code and click Apply; that code is sent with the checkout request and validated.
# Set to true only if you want legacy behavior (automatic % off from parent_percentage_discounts without typing a code).
# CHECKOUT_PERCENT_ALLOW_SAVED_ACCOUNT_DISCOUNT=false

# FAMILY10 org allowlist: exact parent login emails (Auth) that get FAMILY10 at checkout without typing a code
# when CHECKOUT_PERCENT_ALLOW_SAVED_ACCOUNT_DISCOUNT is not true. Everyone else must Apply a valid promo.
# Use the same address they use to log in (e.g. cheryl0320@gmail.com).
# FAMILY10_AUTO_PARENT_EMAILS=cheryl0320@gmail.com,thehickeyclan@gmail.com

# When true, only those emails may sign up with FAMILY10 or redeem FAMILY10 on Account; everyone else gets an error.
# Requires FAMILY10_AUTO_PARENT_EMAILS to list who is allowed. Turn on after setting the emails above.
# FAMILY10_REDEEM_ALLOWLIST_ONLY=false

# Checkout (cart, session register, /api/bookings): when FAMILY10_AUTO_PARENT_EMAILS is non-empty, ONLY those
# emails get a percent discount at payment; stray parent_percentage_discounts rows are ignored for others.
# FAMILY10_REQUIRE_ALLOWLIST_FOR_CHECKOUT=true — same rule even if allowlist is empty (stops all % discounts until you set emails).
# FAMILY10_DISABLE_ALL_CHECKOUT_PERCENT_OFF=true — emergency: no percent discount for anyone at checkout.

# Optional: for "Create invite link" (linked parent). Min 16 chars. If unset, invite link button returns 503.
# PARENT_INVITE_SECRET=your-secret-at-least-16-chars

# Optional: Meta (Facebook / Instagram) Pixel — Landing page views & conversion events in Ads Manager / Events Manager.
# Use your Dataset / Pixel ID (digits only). Find it: Ads Manager → All tools → Events Manager → your Pixel → Settings.
# NEXT_PUBLIC_META_PIXEL_ID=123456789012345

# Optional: Vercel Web Analytics Drain. When you add a Web Analytics Drain (Vercel → Project → Drains), set this to the drain’s "Signature Verification Secret" so we only accept requests from Vercel.
# VERCEL_ANALYTICS_DRAIN_SECRET=your-drain-secret

# Optional: shared secret for server-to-server calls to GET /api/admin/stats (e.g. RecruitNC). Send header: x-guild-api-secret
# GUILD_API_SECRET=your_shared_secret_here

# Optional: Twilio SMS (coach + ops booking alerts). See docs/TWILIO_SMS.md
# Prefer TWILIO_MESSAGING_SERVICE_SID for US A2P (10DLC / verified toll-free pool).
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_MESSAGING_SERVICE_SID=MG...
# Or send from a single number (must be compliant for your use case):
# TWILIO_FROM_NUMBER=+1...
# (TWILIO_PHONE_NUMBER also works — same meaning as TWILIO_FROM_NUMBER; prefer TWILIO_FROM_NUMBER.)
# ADMIN_BOOKING_ALERT_PHONES=+1...,+1...  # ops copy of booking SMS

# Optional: Guild Market (peer-to-peer gear marketplace)
# ANTHROPIC_API_KEY=sk-ant-...  # Claude for condition/price AI on listings
# REMOVE_BG_API_KEY=...  # remove.bg — optional photo background cleanup (50 free/month)
# SHOE_ID_ENABLED=true  # Server gate for POST /api/market/shoe-id (required for brand/model AI from photos)
# NEXT_PUBLIC_SHOE_ID_ENABLED=true  # Seller UI on listing/new — enable both for photo-based shoe ID
# MARKET_STRIPE_WEBHOOK_SECRET=whsec_...  # Separate Stripe webhook endpoint for /api/market/webhook
# EBAY_API_KEY=...  # Optional: eBay comps for price suggestions (stub when unset)
# MARKET_AI_HOURLY_LIMIT=48  # Per-user AI calls/hour (listing flow uses ~5 per photo upload)

# Optional: /coach-help — override the default Loom tutorial for “add to home screen” (YouTube + Loom share links embed in-app)
# Default in app: Loom mobile shortcut tutorial. Set this to swap or use a different host.
# NEXT_PUBLIC_COACH_HELP_HOME_SCREEN_VIDEO_URL=https://www.youtube.com/watch?v=...
